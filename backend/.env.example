# Copy this file to `.env` and fill in the real values.
# NEVER commit the real `.env` file — it is in .gitignore.

PORT=3001
NODE_ENV=development

# JWT — sign the application JWT with this secret.
# Use a long random string (e.g. `openssl rand -hex 32`).
JWT_SECRET=change_me_to_a_long_random_string

# GitHub OAuth app credentials (from https://github.com/settings/developers)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret

# Public URLs (used to build the OAuth redirect and to redirect back to the frontend)
# For local dev these are typical values.
BACKEND_URL=http://localhost:3001
FRONTEND_URL=http://localhost:5173
